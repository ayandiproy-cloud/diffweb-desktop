{
  "name": "diffweb-desktop",
  "productName": "DiffWeb",
  "version": "1.0.0",
  "description": "DiffWeb",
  "author": "Solutionever Technologies",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis appx --x64 --publish always || electron-builder --win nsis --x64 --publish always",
    "store": "electron-builder --win appx --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.diffweb.desktop",
    "productName": "DiffWeb",
    "copyright": "© 2026 DiffWeb. All rights reserved.",
    "artifactName": "DiffWeb-Setup.exe",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "splash.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DiffWeb",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DiffWeb-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ayandiproy-cloud",
        "repo": "diffweb-desktop",
        "releaseType": "release"
      }
    ],
    "appx": {
      "identityName": "SolutioneverTechnologies.DiffWeb",
      "publisher": "CN=1077E7F9-FA87-4345-82C7-CD2AA9E42B2B",
      "publisherDisplayName": "Solutionever Technologies",
      "applicationId": "DiffWeb",
      "displayName": "DiffWeb",
      "backgroundColor": "#4f46e5",
      "languages": [
        "en-US"
      ],
      "artifactName": "DiffWeb-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayandiproy-cloud/diffweb-desktop.git"
  }
}
